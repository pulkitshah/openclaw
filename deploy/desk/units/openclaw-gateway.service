[Unit]
Description=Vasudev Gateway (desk)
After=network-online.target xvfb.service tailscaled.service
Wants=network-online.target xvfb.service
[Service]
User=openclaw
Group=openclaw
WorkingDirectory=/opt/openclaw
# DISPLAY and OPENCLAW_BROWSER_WINDOW_SIZE both match the Xvfb geometry in xvfb.service
# (1920x1080) - a desk has no window manager, so headed Chromium would otherwise open
# at its default ~920x1030 window and sites would render tablet layouts.
Environment=DISPLAY=:99
Environment=OPENCLAW_BROWSER_HEADLESS=0
Environment=OPENCLAW_BROWSER_WINDOW_SIZE=1920x1080
Environment=NODE_ENV=production
# Optional secrets for the Gateway's environment - GOG_HOME and GOG_KEYRING_PASSWORD (gog's file
# keyring on Linux); see deploy/desk/README.md's secrets table. NOT used for Claude sign-in -
# the embedded claude-cli backend clears CLAUDE_CODE_OAUTH_TOKEN from the CLI process it spawns,
# so that credential belongs in `claude`'s own stored login instead (README's "Sign Claude in").
# root:root 0600 - systemd (running as root) reads this file itself before dropping to
# User=openclaw below, so the service user never needs read access to it. Absent on a fresh desk
# (the leading "-" makes a missing file a no-op, not a startup failure).
EnvironmentFile=-/etc/openclaw/secrets/gateway.env
# The hooks bearer for the publicly-Funnelled Gmail webhook, resolved into openclaw.json's
# `hooks.token` by ${HOOKS_TOKEN} env substitution. Same root:root 0600 shape as the file
# above, for the same reason: hooks.token rejects SecretRef objects
# (src/secrets/unsupported-surface-policy.ts), and inlining it in openclaw.json would leave
# it readable by the service user the metadata guard exists to contain. cloud-init writes
# this file; the leading "-" keeps a desk provisioned before it existed starting.
EnvironmentFile=-/etc/openclaw/secrets/hooks-token.env
ExecStart=/usr/bin/node /opt/openclaw/openclaw.mjs gateway run
Restart=always
RestartSec=3
# The Gateway drains active work on SIGTERM and can wait on a live agent session forever; give it
# 45 s, then SIGKILL the whole group (KillMode=mixed) - the lesson from the Part 2 proof.
TimeoutStopSec=45
KillMode=mixed
OOMScoreAdjust=-500
[Install]
WantedBy=multi-user.target

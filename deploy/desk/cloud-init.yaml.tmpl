#cloud-config
# Rendered by deploy/desk/render-cloud-init.mjs - every ALL_CAPS placeholder below must be
# substituted before this file is handed to `doctl compute droplet create --user-data-file`. The
# renderer refuses to emit output while one remains (see section 10 of the design: secrets never ship
# un-substituted or logged in the clear). A mustache-style IF marker line and its closing marker line
# (see render-cloud-init.mjs) bracket a section only some desk profiles render: the owner profile keeps
# every section, the client profile drops TELEGRAM (no bot token secret) and GMAIL_HOOKS (no webhook
# Funnel), matching the config template that profile embeds.
hostname: {{DESK_NAME}}
timezone: Asia/Kolkata
locale: en_IN.UTF-8

users:
  # `default` keeps the image's default account (root on DigitalOcean) and applies the SSH key
  # chosen at create time to it. Without this entry cloud-init drops that key and the desk is
  # unreachable over plain SSH (observed 2026-09-14, attempt 3).
  - default
  - name: openclaw
    system: true
    lock_passwd: true
    shell: /usr/sbin/nologin
    homedir: /home/openclaw

package_update: true
# Only what the tailnet join needs; the desktop/browser packages install in runcmd AFTER the
# desk is on the tailnet (see the ordering note under runcmd).
packages:
  - curl
  - ca-certificates
  - gnupg

# Entries owned by the `openclaw` user or group carry `defer: true`: the write_files module runs
# in the init stage BEFORE users-groups, so a non-deferred openclaw-owned entry fails with
# "Unknown user or group" and aborts the whole module - every later entry, including the
# Tailscale auth key, is then never written (observed 2026-09-14, attempt 4). Deferred entries
# are written in the final stage, after the user exists and before runcmd.
write_files:
  # Security-only unattended-upgrades, never an unattended reboot - kernel/package reboots happen
  # only via roll.sh --reboot in a window the owner picks (spec section 9).
  - path: /etc/apt/apt.conf.d/51openclaw-desk
    permissions: '0644'
    owner: root:root
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      Unattended-Upgrade::Automatic-Reboot "false";

  - path: /etc/systemd/system/xvfb.service
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:units/xvfb.service}}

  - path: /etc/systemd/system/openclaw-gateway.service
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:units/openclaw-gateway.service}}

  - path: /etc/systemd/system/desk-health.service
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:units/desk-health.service}}

  - path: /etc/systemd/system/desk-health.timer
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:units/desk-health.timer}}

  # Blocks the link-local metadata service for non-root processes on every boot - the droplet's
  # user-data (and therefore every secret this cloud-init carried) stays readable from it for the
  # droplet's life. Enabled by the LAST runcmd item, after provisioning, not here.
  - path: /etc/systemd/system/desk-metadata-guard.service
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:units/desk-metadata-guard.service}}

  # The Playwright-managed Chromium reads the chromium/ path; chrome/ is installed alongside for
  # any distro Chrome build that lands on the box later (spec section 4.7).
  - path: /etc/chromium/policies/managed/desk.json
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:chromium-policy.json}}

  - path: /etc/opt/chrome/policies/managed/desk.json
    permissions: '0644'
    owner: root:root
    content: |
      {{INCLUDE:chromium-policy.json}}

  # Ubuntu 24.04 restricts unprivileged user namespaces under AppArmor by default
  # (kernel.apparmor_restrict_unprivileged_userns=1), which blocks Chromium's OWN sandbox setup
  # (unrelated to AppArmor profiles for named binaries) - every browser step died at
  # "open-dashboard" with "FATAL ... No usable sandbox!" (observed 2026-09-14). Restoring
  # Chromium's own sandbox by relaxing this one restriction is strictly safer than the
  # `browser.noSandbox: true` / `--no-sandbox` OpenClaw's own error hint suggests, which disables
  # Chromium's sandbox entirely for every renderer process on the box, not just this restriction.
  - path: /etc/sysctl.d/60-openclaw-desk-chromium.conf
    permissions: '0644'
    owner: root:root
    content: |
      # Restores Chromium's own sandbox on Ubuntu 24.04+ (see the comment above this file's
      # write_files entry in cloud-init.yaml.tmpl for why). Never run Chromium with --no-sandbox
      # instead - that disables the sandbox for every renderer, not just this one restriction.
      kernel.apparmor_restrict_unprivileged_userns = 0

  # Secrets: file-mode 0600, owned by the service user - the Gateway's file secret provider refuses
  # anything more open ("permissions are too open"); root can still read them. Never
  # inline in openclaw.json (SecretRef contract, docs/gateway/secrets/secretref-contract.md).
{{#IF:TELEGRAM}}
  - path: /etc/openclaw/secrets/telegram-bot-token
    permissions: '0600'
    owner: openclaw:openclaw
    defer: true
    content: |
      {{TG_BOT_TOKEN}}

{{/IF}}
  - path: /etc/openclaw/secrets/gateway-token
    permissions: '0600'
    owner: openclaw:openclaw
    defer: true
    content: |
      {{GATEWAY_TOKEN}}

  # Tailscale auth key: 0600, deleted by runcmd immediately after `tailscale up` consumes it.
  - path: /root/ts-authkey
    permissions: '0600'
    owner: root:root
    content: |
      {{TS_AUTHKEY}}

  - path: /home/openclaw/.openclaw/openclaw.json
    permissions: '0600'
    owner: openclaw:openclaw
    defer: true
    content: |
      {{OPENCLAW_CONFIG_JSON}}

runcmd:
  # Ownership of the state dir write_files created ahead of the openclaw user's home existing.
  - [install, -d, -o, openclaw, -g, openclaw, -m, '0700', /home/openclaw/.openclaw]
  - [install, -d, -o, root, -g, root, -m, '0755', /var/lib/openclaw]

  # Apply the Chromium-sandbox sysctl write_files wrote above, before Chromium is ever installed
  # or launched (spec section 4.7; see the comment on that write_files entry for why).
  - sysctl --system

  # Tailscale FIRST: new-desk.sh watches the tailnet for this hostname and the operator can
  # only reach the box over it, so the join must not wait behind the multi-minute package,
  # Node and pnpm installs below. Install, join, then shred the one-time auth key. Tailnet SSH
  # (--ssh) replaces sshd for humans (spec section 4.3); Serve is configured by the Gateway
  # itself at startup via gateway.tailscale.mode: "serve" in openclaw.json - no separate
  # `tailscale serve` CLI step is needed (docs/gateway/tailscale.md).
  - "curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors https://tailscale.com/install.sh | sh"
  # --timeout: with a bad or consumed key `tailscale up` otherwise blocks forever printing an
  # interactive login URL, and the rest of the boot never runs (observed 2026-09-14).
  # No --ssh: Tailscale SSH shadows sshd on the tailnet and, under a "check"-mode SSH rule, turns
  # every login into an interactive browser step - the operator scripts (roll.sh, migrations) need
  # plain key SSH. sshd listens on the tailnet interface too, so ssh root@<desk> works with the
  # DigitalOcean key while the cloud firewall keeps public port 22 closed (observed 2026-09-14).
  {{TAILSCALE_UP_RUNCMD}}
  - shred -u /root/ts-authkey
  # The Gateway runs as openclaw and claims the Serve route itself (gateway.tailscale.mode
  # "serve"); without operator rights it cannot talk to tailscaled and the Control UI never
  # answers on the tailnet (src/infra/tailscale.ts falls back to sudo, which openclaw lacks).
  {{TAILSCALE_OPERATOR_RUNCMD}}
{{#IF:GMAIL_HOOKS}}

  # Gmail push per desk: the Gateway claims Tailscale Serve on 443 as a FOREGROUND listener
  # (gateway.tailscale.mode "serve"), which owns the whole port - a foreground Funnel for the
  # Gmail webhook can never share it (observed 2026-09-14: "foreground listener already exists
  # for port 443"). Instead, a persistent BACKGROUND Funnel on a different port (8443) forwards
  # only the webhook path to gog's own local serve process; tailscaled persists this
  # independently of the Gateway, so it survives restarts/reboots and needs setting only once.
  # Safe to configure before Gmail push is set up for this desk - it is a static forwarding
  # rule to a backend that may not be listening yet, not a request. The matching
  # hooks.gmail.tailscale.mode "off" + hooks.gmail.serve (127.0.0.1:8788, path "/") in
  # openclaw.json.tmpl keep gog's own serve process loopback-only; this Funnel rule alone is
  # what makes it public. The tailnet's Funnel policy must allow port 8443 for this node
  # (`funnel-ports`) - the Tailscale admin console's default Funnel policy already does.
  {{TAILSCALE_FUNNEL_RUNCMD}}
{{/IF}}

  # Desktop, browser and tooling packages (deferred from `packages:` so the tailnet join above
  # is not stuck behind them).
  - DEBIAN_FRONTEND=noninteractive apt-get install -y git xvfb x11-utils fonts-liberation fonts-noto-core fonts-noto-color-emoji fonts-dejavu unattended-upgrades

  # Node 26 (NodeSource) + pnpm via corepack. {{PNPM_PACKAGE_MANAGER}} is the renderer's own
  # repo's package.json "packageManager" field verbatim (e.g. "pnpm@12.3.4+sha512...") so
  # corepack verifies the exact pinned binary against its integrity hash, not just the version.
  - "curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors https://deb.nodesource.com/setup_26.x | bash -"
  - apt-get install -y nodejs
  # Node 25+ no longer bundles corepack, so NodeSource's nodejs package has none: install it
  # with npm first (observed 2026-09-14: `corepack: not found` -> no pnpm -> no build).
  - npm install -g corepack
  - corepack enable
  - corepack prepare {{PNPM_PACKAGE_MANAGER}} --activate
  # Claude Code CLI: the desk's agents use the claude-cli provider (the owner's subscription);
  # the sign-in itself is an owner step after first boot (see the runbook).
  # npm 11 skips install scripts by default; claude-code needs its postinstall to place the
  # binary, so allow exactly that package's scripts (observed 2026-09-14: silent half-install).
  # Guarded the same way the Chromium step below is: `runcmd` has no `set -e`, so a failed install
  # would otherwise pass silently and leave a desk whose agents can never answer, with nothing to
  # show for it. The marker is what desk-health.sh reports as `provisioned: false` and what
  # new-desk.sh warns about before printing success. Never `exit` here - that would skip every
  # later runcmd item (keyfile, unit enablement, reboot) and leave a dead box.
  - >-
    npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code &&
    claude --version
    || { echo "desk: claude-code install FAILED" >&2; touch /var/lib/openclaw/provision-failed; }
  # gog (Google Workspace CLI) drives the Gmail push watcher; pinned to the operator's version
  # with the release checksums from openclaw/homebrew-tap Formula/gogcli.rb - never fetched
  # unverified. Architecture-aware so the local (arm64) pre-flight and amd64 droplets both work.
  # Extracted into a private `mktemp -d`, never `/tmp` itself: the release tarball's own `./`
  # entry carries owner/mode, and extracting straight into `/tmp` as root applies that entry to
  # `/tmp` itself - it went from `1777 root:root` to `0755 501:staff` and silently broke every
  # later use of a writable /tmp (the browser plugin's `mkdtemp`, claude's own tmpdir, plugin
  # cleanup) until it was found and repaired by hand (observed 2026-09-14). The trailing
  # `|| { rm -rf "$workdir" ...; false; }` cleans up the workdir on any failure too (a bad
  # checksum, a dropped download) instead of only on the success path - `false` at the end
  # re-raises the failure so cloud-init still sees this runcmd item as failed, since `rm -rf`
  # itself would otherwise report success and mask it.
  - >-
    workdir="$(mktemp -d)" &&
    cd "$workdir" &&
    arch="$(dpkg --print-architecture)" &&
    case "$arch" in
    amd64) sum=5f73815950f30de4165b7b767103ca45c4950e84a1da601eda5294e9ff94f767 ;;
    arm64) sum=21ca9757f67a573115b517854184561cef6b3b73c21e0f60c72229522c7198ac ;;
    *) echo "desk: no gog build for $arch" >&2; false ;;
    esac &&
    curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors -o gogcli.tgz
    "https://github.com/openclaw/gogcli/releases/download/v0.40.0/gogcli_0.40.0_linux_$arch.tar.gz" &&
    echo "$sum  gogcli.tgz" | sha256sum -c - &&
    tar -xzf gogcli.tgz && install -m 0755 ./gog /usr/local/bin/gog &&
    cd / && rm -rf "$workdir" &&
    gog --version || { rm -rf "$workdir" 2>/dev/null; false; }

  # Fork checkout - pinned to the roll ref the operator asked for. {{FORK_REPO_URL}} is the
  # operator's own fork (render-cloud-init.mjs: --repo-url / DESK_FORK_REPO_URL, defaulting to
  # the renderer's own checkout's `origin` remote) - never a name hardcoded in this template.
  # Shallow: the full fork history is >1 GB and took the clone past 10 minutes on a 2 vCPU box
  # (observed 2026-09-14). fetch+checkout of FETCH_HEAD accepts a branch, tag or commit, and
  # roll.sh updates the same way, so the checkout stays detached at the requested ref.
  # Retried: a throttled or interrupted transfer ("fetch-pack: invalid index-pack output") must not
  # leave the box without a checkout (observed 2026-09-14 in the local pre-flight).
  - >-
    for attempt in 1 2 3 4; do
    rm -rf /opt/openclaw &&
    git clone --depth 1 --no-checkout {{FORK_REPO_URL}} /opt/openclaw &&
    git -C /opt/openclaw fetch --depth 1 origin {{GIT_REF}} &&
    git -C /opt/openclaw checkout --detach FETCH_HEAD && break;
    echo "desk: checkout attempt $attempt failed, retrying in 30s" >&2; sleep 30;
    done;
    test -f /opt/openclaw/package.json || { echo "desk: checkout FAILED after 4 attempts" >&2; touch /var/lib/openclaw/provision-failed; }
  - >-
    cd /opt/openclaw &&
    npm_config_minimum_release_age=0 npm_config_minimum_release_age_strict=false
    pnpm install --frozen-lockfile --ignore-scripts
  # Build memory: the fork's full build (declaration emission) needs ~4.7 GB and refuses on a
  # 4 GB box; the desk only runs the Gateway, so it builds runtime-only (the same mode the
  # installed updater uses: OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1) with the build's explicit heap
  # override and a 4 GB swapfile as headroom (measured 2026-09-14 on 2 vCPU / 4 GB: 2m13s,
  # 56 MB of swap touched). The swapfile stays for the Gateway's own peaks.
  - >-
    test -f /swapfile ||
    (fallocate -l 4G /swapfile && chmod 600 /swapfile && mkswap /swapfile >/dev/null &&
    swapon /swapfile && echo '/swapfile none swap sw 0 0' >> /etc/fstab)
  - >-
    cd /opt/openclaw &&
    OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1 OPENCLAW_TSDOWN_MAX_OLD_SPACE_MB=4352 pnpm build
  - chown -R root:openclaw /opt/openclaw
  - chmod -R g+rX,o-rwx /opt/openclaw
  # desk-health.sh ships inside the fork checkout above (deploy/desk/desk-health.sh) rather than
  # being duplicated into write_files: /opt/openclaw does not exist yet when write_files runs, and
  # `git clone` refuses to clone into a non-empty directory, so writing it earlier would break the
  # clone step. The exec bit is already set in the tree; this is a robustness no-op.
  - chmod +x /opt/openclaw/deploy/desk/desk-health.sh

  # Managed Chromium: OS deps as root, the browser itself as the unprivileged service user (its
  # cache lives under ~openclaw/.cache, not inside the now read-only /opt/openclaw tree). `-H`
  # is required: stock Ubuntu sudoers is `env_reset` without `always_set_home`, so plain
  # `sudo -u openclaw` leaves $HOME=/root - a login shell (`bash -l`) reads dotfiles *from*
  # whatever $HOME already is, it doesn't recompute it - and Playwright would then try to
  # install under /root/.cache/ms-playwright, which openclaw cannot even traverse into. `-H`
  # sets $HOME to openclaw's own home (/home/openclaw) so the cache lands where the Gateway's
  # systemd service (User=openclaw, which does default $HOME correctly) will actually look for
  # it. `runcmd` has no `set -e`, so a failure here would otherwise pass silently and the
  # Gateway would start with no Chromium installed for the openclaw user; the explicit
  # The guard makes that failure loud and leaves a marker for desk-health; it must NOT exit: an
  # exit inside cloud-init's runcmd skips every later step (keyfile, unit enablement, reboot) and
  # leaves a dead, unreachable box (observed 2026-09-14 in the local pre-flight).
  - cd /opt/openclaw && npx playwright install-deps chromium
  - >-
    sudo -H -u openclaw bash -lc "cd /opt/openclaw && npx playwright install chromium"
    || { echo "desk: chromium install FAILED" >&2; touch /var/lib/openclaw/provision-failed; }

  # Per-desk credential keyfile for extensions/duties' Linux cred backend (spec section 5).
  # ONLY if absent: a droplet created from a prior desk's snapshot gets a new instance id, so
  # cloud-init re-runs every per-instance module over a disk that already carries that desk's
  # encrypted credential store (~openclaw/.openclaw/plugins/duties/creds.enc). A fresh keyfile
  # cannot decrypt it and every login then fails with "credential store is corrupt or was written
  # with another keyfile", with no hint that the keyfile was rotated underneath it. The
  # ownership/mode lines stay unconditional so a restored keyfile is always correctly owned.
  - "test -f /etc/openclaw/keyfile || head -c 32 /dev/urandom > /etc/openclaw/keyfile"
  - chown root:openclaw /etc/openclaw/keyfile
  - chmod 640 /etc/openclaw/keyfile

  - systemctl daemon-reload
  - systemctl enable --now xvfb.service
  - systemctl enable --now desk-health.timer
  - systemctl enable --now openclaw-gateway.service

  # Metadata guard LAST, and only now that provisioning is done: DigitalOcean keeps this droplet's
  # user-data (which carried the Tailscale auth key, the Telegram bot token, the Gateway token and
  # the minted hooks token) readable for the droplet's whole life from the unauthenticated
  # link-local metadata service, to ANY local process - including a browser Duty or an `exec` step
  # driven by untrusted inbound mail. This unit rejects egress to 169.254.169.254 for every
  # non-root uid, which keeps the secrets out of reach of the `openclaw` service user while root
  # (and cloud-init on the next boot) keeps working. Enabled only here because provisioning itself
  # may need the metadata service; `--now` applies it immediately for the window before the reboot
  # below. It is NOT a substitute for using a single-use/ephemeral Tailscale auth key - see the
  # security notes in docs/hosted-desk.md.
  - systemctl enable --now desk-metadata-guard.service

power_state:
  mode: reboot
  message: Vasudev desk provisioned - rebooting to apply the keyfile-owned services cleanly.
  timeout: 30
  condition: true

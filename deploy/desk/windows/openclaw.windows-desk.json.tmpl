{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "tailscale": { "mode": "serve" },
    "controlUi": {
      "communityInvite": false,
      "allowedOrigins": ["{{FRONT_DOOR_ORIGIN}}", "https://{{TAILNET_HOST}}"]
    },
    "trustedProxies": ["127.0.0.1"],
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "userHeader": "x-forwarded-user",
        "allowUsers": ["{{OWNER_EMAIL}}"],
        "allowLoopback": true,
        "deviceAutoApprove": { "enabled": true }
      },
      "allowTailscale": true,
      "identityScopes": {
        "{{OWNER_EMAIL}}": ["operator.admin"],
        "pulkitshah@github": ["operator.admin"]
      },
      "password": { "source": "file", "provider": "gateway-admin-password-file", "id": "value" }
    },
    "nodes": {
      "browser": { "mode": "auto" },
      "commands": { "allow": ["desktop.stream"] }
    }
  },
  "secrets": {
    "providers": {
      "gateway-admin-password-file": {
        "source": "file",
        "path": "C:\\opt\\secrets\\gateway-admin-password",
        "mode": "singleValue"
      }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "anthropic/claude-opus-5": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-sonnet-5": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-fable-5-1": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-fable-5": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-opus-4-8": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-opus-4-7": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-sonnet-4-6": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-opus-4-6": { "agentRuntime": { "id": "claude-cli" } }
      }
    }
  },
  "desktop": { "host": { "enabled": true, "port": 5900, "passwordFile": "C:\\opt\\vnc-password.txt" } },
  "browser": { "ssrfPolicy": { "allowedHostnames": ["127.0.0.1"] } },
  "plugins": {
    "entries": {
      "anthropic": { "enabled": true, "config": { "sessionCatalog": { "enabled": false } } },
      "duties": { "enabled": true },
      "llm-task": { "enabled": true },
      "wallet": { "enabled": true },
      "cua-computer": { "enabled": true }
    }
  },
  "tools": { "profile": "full", "alsoAllow": ["llm-task"] }
}

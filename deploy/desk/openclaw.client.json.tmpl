{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "tailscale": { "mode": "{{GATEWAY_TAILSCALE_MODE}}" },
    "controlUi": { "communityInvite": false },
    "auth": {
      "mode": "token",
      "token": { "source": "file", "provider": "gateway-token-file", "id": "value" }
    }
  },
  "secrets": {
    "providers": {
      "gateway-token-file": {
        "source": "file",
        "path": "/etc/openclaw/secrets/gateway-token",
        "mode": "singleValue"
      }
    }
  },
  "browser": {
    "ssrfPolicy": { "allowedHostnames": ["127.0.0.1"] }
  },
  "plugins": {
    "entries": {
      "anthropic": { "enabled": true, "config": { "sessionCatalog": { "enabled": false } } },
      "duties": { "enabled": true },
      "telegram": { "enabled": true },
      "llm-task": { "enabled": true },
      "wallet": { "enabled": true }
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "anthropic/claude-opus-5": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-sonnet-5": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-fable-5-1": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-fable-5": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-opus-4-8": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-opus-4-7": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-sonnet-4-6": { "agentRuntime": { "id": "claude-cli" } },
        "anthropic/claude-opus-4-6": { "agentRuntime": { "id": "claude-cli" } }
      }
    }
  },
  "tools": {
    "profile": "full",
    "alsoAllow": ["llm-task"]
  }
}
